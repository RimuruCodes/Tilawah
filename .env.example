# Client-side env vars for the subscription system (see README.md >
# Subscriptions). Safe to expose in the built bundle — never put secret
# keys here. Copy this file to `.env.local` and fill in your own project's
# values; the app works fine for free/local-only usage without these set.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
